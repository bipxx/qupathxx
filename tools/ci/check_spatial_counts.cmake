if(NOT EXISTS "${IMPORTER}" OR NOT EXISTS "${FIXTURE}" OR NOT DEFINED WORK)
  message(FATAL_ERROR "Supply IMPORTER, FIXTURE and WORK")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
file(MAKE_DIRECTORY "${WORK}")
set(directory "${WORK}/${run_id}")
execute_process(COMMAND "${FIXTURE}" --prepare "${directory}" RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 10)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Native fixture failed: ${error}")
endif()
set(args "${directory}/input.qpx" "${directory}/output.qpx" 1 "${directory}/counts.mtx" "${directory}/features.tsv" "${directory}/positions.tsv" --gene G2 --gene G1)
file(SHA256 "${directory}/input.qpx" source_before)
execute_process(COMMAND "${IMPORTER}" ${args} RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE error TIMEOUT 10)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Native spatial import failed: ${report}${error}")
endif()
string(JSON count GET "${report}" observations)
if(NOT count EQUAL 3)
  message(FATAL_ERROR "Wrong observation count: ${report}")
endif()
execute_process(COMMAND "${FIXTURE}" --verify "${directory}/output.qpx" RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 10)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Native retained projection failed: ${error}")
endif()
file(SHA256 "${directory}/output.qpx" output_before)
execute_process(COMMAND "${IMPORTER}" ${args} RESULT_VARIABLE result OUTPUT_VARIABLE ignored ERROR_VARIABLE error TIMEOUT 10)
if(NOT result STREQUAL "2")
  message(FATAL_ERROR "Expected no-overwrite refusal: ${error}")
endif()
file(SHA256 "${directory}/input.qpx" source_after)
file(SHA256 "${directory}/output.qpx" output_after)
if(NOT source_before STREQUAL source_after OR NOT output_before STREQUAL output_after)
  message(FATAL_ERROR "Source or previous output changed")
endif()
message(STATUS "Native spatial CLI/retained counts/no-overwrite passed: ${directory}")
