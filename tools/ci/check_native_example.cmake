if(NOT EXISTS "${EXAMPLE}" OR NOT DEFINED WORK)
  message(FATAL_ERROR "Supply EXAMPLE executable and WORK directory")
endif()
# New names permit repeated checks without deleting any previous user outputs.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(directory "${WORK}/${run_id}")
file(MAKE_DIRECTORY "${directory}")
set(source "${directory}/input.qpx")
set(output "${directory}/analysis.qpx")
execute_process(COMMAND "${EXAMPLE}" --demo "${source}" RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 10)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Native demo creation failed: ${log}${error}")
endif()
file(SHA256 "${source}" source_before)
execute_process(COMMAND "${EXAMPLE}" "${source}" "${output}" RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 10)
if(NOT result STREQUAL "0" OR NOT log MATCHES "samples=2 output=")
  message(FATAL_ERROR "Native open/analyze/save/replay failed: ${log}${error}")
endif()
file(SHA256 "${output}" output_before)
execute_process(COMMAND "${EXAMPLE}" "${source}" "${output}" RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 10)
if(result STREQUAL "0")
  message(FATAL_ERROR "Existing analysis output was accepted")
endif()
file(SHA256 "${source}" source_after)
file(SHA256 "${output}" output_after)
if(NOT source_before STREQUAL source_after OR NOT output_before STREQUAL output_after)
  message(FATAL_ERROR "Input or previously saved output changed")
endif()
message(STATUS "Native open/analyze/save/replay and no-overwrite passed: ${directory}")
