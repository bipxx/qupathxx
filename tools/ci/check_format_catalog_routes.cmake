if(NOT EXISTS "${REGION}" OR NOT EXISTS "${BATCH}")
  message(FATAL_ERROR "Supply REGION and BATCH executables")
endif()
foreach(program IN ITEMS REGION BATCH APP)
  if(program STREQUAL "APP" AND NOT DEFINED APP)
    continue()
  endif()
  execute_process(COMMAND "${${program}}" --formats RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "${program} format listing failed: ${result}; ${error}")
  endif()
  string(JSON schema GET "${output}" schema)
  string(JSON matrices LENGTH "${output}" matrix)
  string(JSON annotations LENGTH "${output}" annotations)
  if(NOT schema STREQUAL "qpx.format-catalog/1" OR NOT matrices EQUAL 3 OR NOT annotations EQUAL 2)
    message(FATAL_ERROR "${program} format membership/schema differs")
  endif()
  if(DEFINED reference AND NOT output STREQUAL reference)
    message(FATAL_ERROR "Native frontends expose different format catalogs")
  endif()
  set(reference "${output}")
endforeach()
message(STATUS "Native matrix/annotation catalog routes agree")
