if(NOT IS_ABSOLUTE "${QUPATHXX_READER_PLUGIN_KIT_PREFIX}" OR
    NOT IS_DIRECTORY "${QUPATHXX_READER_PLUGIN_KIT_PREFIX}" OR NOT DEFINED WORK)
  message(FATAL_ERROR "Supply an absolute installed QUPATHXX_READER_PLUGIN_KIT_PREFIX and WORK")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
get_filename_component(directory "${WORK}/${run_id}" ABSOLUTE)
file(MAKE_DIRECTORY "${directory}")
file(REAL_PATH "${directory}" directory)
set(staged "${directory}/staged-install")
set(relocated "${directory}/relocated-install")
cmake_path(IS_PREFIX directory "${staged}" NORMALIZE staged_owned)
cmake_path(IS_PREFIX directory "${relocated}" NORMALIZE relocated_owned)
if(NOT staged_owned OR NOT relocated_owned)
  message(FATAL_ERROR "Unsafe owned relocation paths")
endif()
# Copy an already installed development stage, then relocate only this unique
# inactive copy. Never move the caller's install or remove previous evidence.
file(COPY "${QUPATHXX_READER_PLUGIN_KIT_PREFIX}/" DESTINATION "${staged}")
file(RENAME "${staged}" "${relocated}")
set(kit "${relocated}/share/qupathxx/reader-plugin")
set(host "${relocated}/qupathxx/qupathxx_region.exe")
foreach(member "${host}" "${relocated}/include/qupathxx/reader_plugin.h"
    "${kit}/profile.cmake" "${kit}/decoder/ppm_decoder.hpp" "${kit}/decoder/ppm_decoder.cpp"
    "${kit}/example/CMakeLists.txt" "${kit}/example/p6_plugin.cpp")
  if(NOT EXISTS "${member}")
    message(FATAL_ERROR "Missing installed reader-plugin member: ${member}")
  endif()
endforeach()
set(external_source "${directory}/external-source")
set(external_build "${directory}/external-build")
set(modules "${directory}/external-installed-module")
set(cwd "${directory}/unrelated-cwd")
file(MAKE_DIRECTORY "${external_source}" "${cwd}")
file(COPY "${kit}/example/" DESTINATION "${external_source}")
set(configure_args -DCMAKE_BUILD_TYPE=Release -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreadedDLL
  "-DQUPATHXX_READER_PLUGIN_KIT_PREFIX=${relocated}")
if(DEFINED GENERATOR AND NOT GENERATOR STREQUAL "")
  list(APPEND configure_args -G "${GENERATOR}")
endif()
if(DEFINED CXX_COMPILER AND NOT CXX_COMPILER STREQUAL "")
  list(APPEND configure_args "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}")
endif()
if(DEFINED MAKE_PROGRAM AND NOT MAKE_PROGRAM STREQUAL "")
  list(APPEND configure_args "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${external_source}" -B "${external_build}"
  ${configure_args} "--graphviz=${external_build}/targets.dot"
  RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 60)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Installed external reader-plugin configure failed: ${log}${error}")
endif()
file(READ "${external_build}/targets.dot" targets)
if(targets MATCHES "qupathxx::core|qupathxx_core|nanobind|_native")
  message(FATAL_ERROR "Independent plugin unexpectedly depends on the application core or Python: ${targets}")
endif()
# The installed kit must reject a mismatched CRT before any module build. Keep
# the admitted positive build/cache intact and diagnose this specific guard.
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${external_source}" -B "${directory}/external-build-static-crt"
  ${configure_args} -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded
  RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 60)
if(result STREQUAL "0" OR NOT "${log}${error}" MATCHES "Release dynamic CRT")
  message(FATAL_ERROR "Installed plugin kit did not reject the static CRT for its declared reason: ${result}; ${log}${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${external_build}" --config Release --target qpx_p6_plugin
  RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 60)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Installed external reader-plugin build failed: ${log}${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${external_build}" --config Release --prefix "${modules}"
  RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 30)
if(NOT result STREQUAL "0" OR NOT EXISTS "${modules}/qpx_p6_plugin.dll" OR NOT EXISTS "${modules}/reader-plugins.json")
  message(FATAL_ERROR "Independent module installation failed: ${log}${error}")
endif()
set(manifest "${modules}/reader-plugins.json")
file(READ "${manifest}" descriptor)
file(SHA256 "${modules}/qpx_p6_plugin.dll" actual_hash)
string(JSON recorded_hash GET "${descriptor}" plugins 0 module sha256)
if(NOT recorded_hash STREQUAL actual_hash)
  message(FATAL_ERROR "Installed example descriptor does not bind the actual module bytes")
endif()
execute_process(COMMAND "${host}" --reader-plugins "${manifest}" --readers WORKING_DIRECTORY "${cwd}"
  RESULT_VARIABLE result OUTPUT_VARIABLE catalog ERROR_VARIABLE error TIMEOUT 15)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Relocated installed host could not enumerate the external decoder: ${catalog}${error}")
endif()
string(JSON count LENGTH "${catalog}" readers)
math(EXPR last "${count}-1")
set(found FALSE)
foreach(index RANGE 0 ${last})
  string(JSON provider GET "${catalog}" readers ${index} provider_id)
  if(provider STREQUAL "org.qupathxx.p6")
    string(JSON available GET "${catalog}" readers ${index} available)
    string(JSON display GET "${catalog}" readers ${index} display_rgba)
    string(JSON raw GET "${catalog}" readers ${index} raw_samples)
    if(found OR NOT available OR NOT display OR raw)
      message(FATAL_ERROR "External P6 catalog entry has wrong availability/capabilities: ${catalog}")
    endif()
    set(found TRUE)
  endif()
endforeach()
if(NOT found)
  message(FATAL_ERROR "Relocated host omitted the independently built P6 provider: ${catalog}")
endif()
set(source "${directory}/independent.ppm")
file(WRITE "${source}" "P6\n2 2\n255\nABCDEFGHIJKL")
file(SHA256 "${source}" before)
string(HEX "P7\nWIDTH 2\nHEIGHT 2\nDEPTH 4\nMAXVAL 255\nTUPLTYPE RGB_ALPHA\nENDHDR\n" expected)
string(APPEND expected "414243ff444546ff474849ff4a4b4cff")
function(check_mode name)
  set(output "${directory}/${name}.pam")
  execute_process(COMMAND "${host}" --reader-plugins "${manifest}" --reader org.qupathxx.p6 ${ARGN} "${output}"
    WORKING_DIRECTORY "${cwd}" RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 15)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "External relocated P6 ${name} failed: ${log}${error}")
  endif()
  file(READ "${output}" actual HEX)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "External P6 ${name} changed independent exact PAM bytes")
  endif()
endfunction()
check_mode(region "${source}" 0 0 0 2 2)
check_mode(thumbnail --thumbnail "${source}" 2 2)
check_mode(resample --resample "${source}" 0 0 0 2 2 2 2)
check_mode(rgb-nominal --rgb-nominal "${source}" 0 0 2 2 1)
set(broken "${directory}/truncated.ppm")
file(WRITE "${broken}" "P6\n2 2\n255\nAB")
execute_process(COMMAND "${host}" --reader-plugins "${manifest}" --reader org.qupathxx.p6
  "${broken}" 0 0 0 2 2 "${directory}/must-not-exist.pam" WORKING_DIRECTORY "${cwd}"
  RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 15)
if(NOT result STREQUAL "1" OR EXISTS "${directory}/must-not-exist.pam" OR NOT error MATCHES "truncated PPM raster" OR NOT error MATCHES "Reader plugin open")
  message(FATAL_ERROR "Independent module did not refuse its truncated P6 source: ${result}; ${log}${error}")
endif()
execute_process(COMMAND "${host}" --reader-plugins "${manifest}" --reader org.qupathxx.p6 --raw
  WORKING_DIRECTORY "${cwd}" RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 15)
if(NOT result STREQUAL "2")
  message(FATAL_ERROR "P6 display plugin entered the explicit TIFF raw route: ${result}; ${log}${error}")
endif()
file(SHA256 "${source}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "External plugin changed its scientific input")
endif()
message(STATUS "Installed relocated host and independently built P6 module preserve four display modes and exact bytes: ${directory}")
