if(NOT EXISTS "${REGION}" OR NOT DEFINED WORK)
  message(FATAL_ERROR "Supply REGION executable and WORK directory")
endif()

execute_process(COMMAND "${REGION}" --readers RESULT_VARIABLE result OUTPUT_VARIABLE catalog ERROR_VARIABLE error TIMEOUT 10)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Native reader catalog failed: ${error}")
endif()
string(JSON schema GET "${catalog}" schema)
string(JSON count LENGTH "${catalog}" readers)
if(NOT schema STREQUAL "qpx.reader-catalog/1" OR NOT count EQUAL 4)
  message(FATAL_ERROR "Unexpected native reader catalog: ${catalog}")
endif()
set(expected_ids ppm openslide tiff ome-zarr)
foreach(index RANGE 0 3)
  list(GET expected_ids ${index} expected_id)
  string(JSON provider GET "${catalog}" readers ${index} provider_id)
  string(JSON available_type TYPE "${catalog}" readers ${index} available)
  string(JSON available GET "${catalog}" readers ${index} available)
  string(JSON reason GET "${catalog}" readers ${index} unavailable_reason)
  string(JSON display_type TYPE "${catalog}" readers ${index} display_rgba)
  string(JSON display GET "${catalog}" readers ${index} display_rgba)
  string(JSON raw_type TYPE "${catalog}" readers ${index} raw_samples)
  string(JSON raw GET "${catalog}" readers ${index} raw_samples)
  if(NOT provider STREQUAL expected_id OR NOT available_type STREQUAL "BOOLEAN" OR
      NOT display_type STREQUAL "BOOLEAN" OR NOT display OR NOT raw_type STREQUAL "BOOLEAN")
    message(FATAL_ERROR "Missing known reader or malformed catalog fields: ${catalog}")
  endif()
  if((available AND NOT reason STREQUAL "") OR (NOT available AND reason STREQUAL ""))
    message(FATAL_ERROR "Catalog availability lacks its matching diagnostic: ${catalog}")
  endif()
  if(provider STREQUAL "ppm" AND NOT available)
    message(FATAL_ERROR "The built-in PPM adapter must always be available")
  endif()
  if((provider STREQUAL "tiff" OR provider STREQUAL "ome-zarr") AND NOT raw)
    message(FATAL_ERROR "Quantitative provider lost its static capability")
  elseif((provider STREQUAL "ppm" OR provider STREQUAL "openslide") AND raw)
    message(FATAL_ERROR "Display provider unexpectedly claims original raw samples")
  endif()
endforeach()

# A unique owned directory preserves previous outputs and failed evidence.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(directory "${WORK}/${run_id}")
file(MAKE_DIRECTORY "${directory}")
set(source "${directory}/input.ppm")
# Nonzero independent P6 RGB bytes avoid CMake's prohibition on NUL strings.
file(WRITE "${source}" "P6\n2 2\n255\nABCDEFGHIJKL")
file(SHA256 "${source}" source_before)
# Compare explicit LF header bytes in memory: file(WRITE) translates line
# endings on Windows, while the product deliberately writes binary PAM bytes.
string(HEX "P7\nWIDTH 2\nHEIGHT 2\nDEPTH 4\nMAXVAL 255\nTUPLTYPE RGB_ALPHA\nENDHDR\n" expected)
string(APPEND expected "414243ff444546ff474849ff4a4b4cff")

function(check_display_mode name)
  set(automatic "${directory}/${name}-auto.pam")
  set(explicit "${directory}/${name}-ppm.pam")
  execute_process(COMMAND "${REGION}" ${ARGN} "${automatic}"
    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 10)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Legacy ${name} command failed: ${log}${error}")
  endif()
  execute_process(COMMAND "${REGION}" --reader ppm ${ARGN} "${explicit}"
    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 10)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Explicit PPM ${name} command failed: ${log}${error}")
  endif()
  file(READ "${automatic}" automatic_bytes HEX)
  file(READ "${explicit}" explicit_bytes HEX)
  if(NOT automatic_bytes STREQUAL expected OR NOT explicit_bytes STREQUAL expected)
    message(FATAL_ERROR "${name} changed the independent P6-to-PAM byte oracle")
  endif()
endfunction()
check_display_mode(region "${source}" 0 0 0 2 2)
check_display_mode(thumbnail --thumbnail "${source}" 2 2)
check_display_mode(resample --resample "${source}" 0 0 0 2 2 2 2)
check_display_mode(rgb-nominal --rgb-nominal "${source}" 0 0 2 2 1)

foreach(reader IN ITEMS tiff openslide unknown-reader)
  set(output "${directory}/refused-${reader}.pam")
  execute_process(COMMAND "${REGION}" --reader "${reader}" "${source}" 0 0 0 2 2 "${output}"
    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 10)
  if(NOT result STREQUAL "1" OR EXISTS "${output}")
    message(FATAL_ERROR "Explicit ${reader} did not refuse PPM without fallback: ${result}; ${log}${error}")
  endif()
endforeach()
execute_process(COMMAND "${REGION}" --reader ppm --raw
  RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 10)
if(NOT result STREQUAL "2" OR NOT error MATCHES "applies only to display")
  message(FATAL_ERROR "Display-only reader selection reached the raw CLI: ${result}; ${log}${error}")
endif()
execute_process(COMMAND "${REGION}" --readers extra
  RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 10)
if(NOT result STREQUAL "2")
  message(FATAL_ERROR "Reader listing accepted extra arguments: ${result}; ${log}${error}")
endif()
file(SHA256 "${source}" source_after)
if(NOT source_before STREQUAL source_after)
  message(FATAL_ERROR "Native reader routes modified their P6 input")
endif()
message(STATUS "Native reader catalog and four display modes preserve selection, bytes and refusal paths: ${directory}")
