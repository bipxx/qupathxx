# Extract notice comments from the exact dependency sources used by this build.
function(qupathxx_header_notice source marker directory name)
  file(READ "${source}" contents)
  string(FIND "${contents}" "${marker}" start)
  if(start LESS 0)
    message(FATAL_ERROR "Missing expected notice marker in ${source}: ${marker}")
  endif()
  string(SUBSTRING "${contents}" ${start} -1 notice)
  string(FIND "${notice}" "*/" end)
  if(end LESS 0)
    message(FATAL_ERROR "Unterminated notice in ${source}")
  endif()
  math(EXPR length "${end}+2")
  string(SUBSTRING "${notice}" 0 ${length} notice)
  if(NOT notice MATCHES "[Ll]icen[cs]e|[Pp]ermission|public domain")
    message(FATAL_ERROR "Expected a license notice in ${source}")
  endif()
  set(output "${CMAKE_CURRENT_BINARY_DIR}/generated/third-party-notices/${directory}/${name}")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated/third-party-notices/${directory}")
  file(WRITE "${output}" "${notice}\n")
  install(FILES "${output}" DESTINATION "qupathxx/licenses/${directory}")
endfunction()
