set(qpx_sdk_mapped_targets "")
function(qpx_sdk_library name target)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "SDK required native library is missing: ${target}")
  endif()
  get_target_property(alias "${target}" ALIASED_TARGET)
  if(alias)
    set(target "${alias}")
  endif()
  list(APPEND qpx_sdk_mapped_targets "${target}")
  list(APPEND qpx_sdk_private_targets "qupathxx::_${name}")
  install(FILES "$<TARGET_LINKER_FILE:${target}>" DESTINATION lib/qupathxx/deps
    RENAME "qpx-${name}.lib" CONFIGURATIONS Release COMPONENT NativeSDK)
  string(APPEND qpx_sdk_dependency_code
    "add_library(qupathxx::_${name} UNKNOWN IMPORTED)\n"
    "set_target_properties(qupathxx::_${name} PROPERTIES IMPORTED_LOCATION \"\${_qpx_sdk_prefix}/lib/qupathxx/deps/qpx-${name}.lib\")\n"
    "if(NOT EXISTS \"\${_qpx_sdk_prefix}/lib/qupathxx/deps/qpx-${name}.lib\")\n"
    "  message(FATAL_ERROR \"Missing SDK dependency: qpx-${name}.lib\")\nendif()\n")
  set(qpx_sdk_mapped_targets "${qpx_sdk_mapped_targets}" PARENT_SCOPE)
  set(qpx_sdk_private_targets "${qpx_sdk_private_targets}" PARENT_SCOPE)
  set(qpx_sdk_dependency_code "${qpx_sdk_dependency_code}" PARENT_SCOPE)
endfunction()
