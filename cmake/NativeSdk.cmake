# Audit the real CMake target graph, including hidden static dependencies.
# Header-only JSON and platform Threads add no installed third-party libraries.
set_property(GLOBAL PROPERTY QPX_SDK_SEEN "")
set_property(GLOBAL PROPERTY QPX_SDK_SYSTEM_LINKS "")
function(qpx_sdk_check dependency)
  while(dependency MATCHES "^\\$<LINK_ONLY:(.*)>$")
    set(dependency "${CMAKE_MATCH_1}")
  endwhile()
  if(dependency STREQUAL "" OR dependency STREQUAL "nlohmann_json::nlohmann_json" OR dependency STREQUAL "Threads::Threads")
    return()
  endif()
  if(TARGET "${dependency}")
    get_target_property(alias "${dependency}" ALIASED_TARGET)
    if(alias)
      set(dependency "${alias}")
    endif()
    get_property(seen GLOBAL PROPERTY QPX_SDK_SEEN)
    if(dependency IN_LIST seen)
      return()
    endif()
    set_property(GLOBAL APPEND PROPERTY QPX_SDK_SEEN "${dependency}")
    if(NOT dependency IN_LIST qpx_sdk_mapped_targets AND NOT dependency IN_LIST qpx_sdk_targets)
      message(FATAL_ERROR "Unmapped SDK transitive native target: ${dependency}")
    endif()
    get_target_property(links "${dependency}" INTERFACE_LINK_LIBRARIES)
    if(links)
      foreach(link IN LISTS links)
        qpx_sdk_check("${link}")
      endforeach()
    endif()
  elseif(dependency MATCHES "^(bcrypt|shlwapi|kernel32|user32|gdi32|shell32|ole32|oleaut32|uuid|comdlg32|advapi32|ws2_32)$")
    set_property(GLOBAL APPEND PROPERTY QPX_SDK_SYSTEM_LINKS "${dependency}")
  else()
    message(FATAL_ERROR "Unmapped SDK transitive link requirement: ${dependency}")
  endif()
endfunction()
foreach(target IN LISTS qpx_sdk_targets)
  qpx_sdk_check("${target}")
endforeach()
get_property(qpx_sdk_system_links GLOBAL PROPERTY QPX_SDK_SYSTEM_LINKS)
list(REMOVE_DUPLICATES qpx_sdk_system_links)
string(APPEND qpx_sdk_dependency_code
  "add_library(qupathxx::_native_dependencies INTERFACE IMPORTED)\n"
  "set_property(TARGET qupathxx::_native_dependencies PROPERTY INTERFACE_LINK_LIBRARIES \"${qpx_sdk_private_targets};${qpx_sdk_system_links}\")\n")
foreach(target IN LISTS qpx_sdk_targets)
  get_target_property(build_links "${target}" INTERFACE_LINK_LIBRARIES)
  if(target STREQUAL "qupathxx_core")
    set(installed_links "Threads::Threads;$<LINK_ONLY:qupathxx::_native_dependencies>")
  else()
    set(installed_links "qupathxx::core")
  endif()
  set_property(TARGET "${target}" PROPERTY INTERFACE_LINK_LIBRARIES
    "$<BUILD_INTERFACE:${build_links}>;$<INSTALL_INTERFACE:${installed_links}>")
endforeach()
