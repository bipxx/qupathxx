# Immutable GUI-only font assets. Headless configurations never download them.
set(QPX_GUI_FONT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/qpx-gui-fonts")
file(MAKE_DIRECTORY "${QPX_GUI_FONT_DIRECTORY}")
function(qpx_gui_font_download name url sha256)
  set(path "${QPX_GUI_FONT_DIRECTORY}/${name}")
  if(EXISTS "${path}")
    file(SHA256 "${path}" actual)
  else()
    set(actual "")
  endif()
  if(NOT "${actual}" STREQUAL "${sha256}")
    file(DOWNLOAD "${url}" "${path}" EXPECTED_HASH "SHA256=${sha256}" TLS_VERIFY ON STATUS result)
    list(GET result 0 status)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Cannot obtain verified GUI font asset ${name}: ${result}")
    endif()
  endif()
endfunction()
