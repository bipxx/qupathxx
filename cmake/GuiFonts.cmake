install(FILES "${QPX_GUI_FONT_DIRECTORY}/emoji-OFL.txt" DESTINATION qupathxx/licenses/noto-emoji RENAME OFL.txt)
function(qupathxx_copy_gui_fonts target)
  add_custom_command(TARGET ${target} POST_BUILD
    COMMAND "${CMAKE_COMMAND}" -E make_directory "$<TARGET_FILE_DIR:${target}>/fonts"
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different
      "${QPX_GUI_FONT_DIRECTORY}/${QPX_GUI_CJK_NAME}" "${QPX_GUI_FONT_DIRECTORY}/${QPX_GUI_EMOJI_NAME}"
      "$<TARGET_FILE_DIR:${target}>/fonts")
endfunction()

# A configured atlas cap is valid resource exhaustion, not a violated invariant.
# Keep upstream untouched, normalize checkout newlines, and generate one guarded
# derivative retaining every other assertion and the existing false return.
file(READ "${imgui_SOURCE_DIR}/imgui_draw.cpp" draw_source)
string(REPLACE "\r\n" "\n" draw_source "${draw_source}")
string(SHA256 draw_sha256 "${draw_source}")
if(NOT draw_sha256 STREQUAL "9d65a8f6e53adc2baa89eb6ea285601a0c0294bd0e624ddb4926f05dd0a55f3f")
  message(FATAL_ERROR "Review the GUI font quota patch for the changed ImGui source")
endif()
set(quota_assert "            IM_ASSERT(pack_id != ImFontAtlasRectId_Invalid && \"Out of texture memory.\");")
string(REPLACE "${quota_assert}" "            // qpx: a configured atlas cap is recoverable glyph exhaustion." patched_draw "${draw_source}")
if(patched_draw STREQUAL draw_source)
  message(FATAL_ERROR "GUI font quota patch did not match")
endif()
set(QPX_IMGUI_DRAW_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/generated/imgui_draw_qpx.cpp")
file(CONFIGURE OUTPUT "${QPX_IMGUI_DRAW_SOURCE}" CONTENT "${patched_draw}" @ONLY NEWLINE_STYLE UNIX)
