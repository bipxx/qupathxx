# Bundle only explicit imported shared runtimes, under their loader SONAMEs.
# The C API's own RUNPATH must resolve its C++ dependency after relocation.
if(NOT EXISTS "${GEOS_LICENSE_FILE}")
  message(FATAL_ERROR "Bundling GEOS requires GEOS_LICENSE_FILE from the matching SDK")
endif()
foreach(_geos_target GEOS::geos_c GEOS::geos)
  if(NOT TARGET ${_geos_target})
    message(FATAL_ERROR "Bundling GEOS requires both imported GEOS shared targets")
  endif()
  get_target_property(_geos_type ${_geos_target} TYPE)
  if(NOT _geos_type STREQUAL "SHARED_LIBRARY")
    message(FATAL_ERROR "Bundling GEOS requires shared libraries: ${_geos_target}")
  endif()
  install(FILES "$<TARGET_FILE:${_geos_target}>" DESTINATION qupathxx
    RENAME "$<TARGET_SONAME_FILE_NAME:${_geos_target}>")
endforeach()
if(NOT CMAKE_READELF)
  find_program(CMAKE_READELF NAMES readelf llvm-readelf REQUIRED)
endif()
get_target_property(_geos_configs GEOS::geos_c IMPORTED_CONFIGURATIONS)
set(_geos_locations)
foreach(_geos_config IN LISTS _geos_configs)
  string(TOUPPER "${_geos_config}" _geos_config)
  get_target_property(_geos_location GEOS::geos_c "IMPORTED_LOCATION_${_geos_config}")
  if(_geos_location)
    list(APPEND _geos_locations "${_geos_location}")
  endif()
endforeach()
get_target_property(_geos_location GEOS::geos_c IMPORTED_LOCATION)
if(_geos_location)
  list(APPEND _geos_locations "${_geos_location}")
endif()
list(REMOVE_DUPLICATES _geos_locations)
if(NOT _geos_locations)
  message(FATAL_ERROR "Cannot locate imported GEOS C runtime for relocation validation")
endif()
foreach(_geos_location IN LISTS _geos_locations)
  execute_process(COMMAND "${CMAKE_READELF}" -d "${_geos_location}"
    RESULT_VARIABLE _geos_readelf_status OUTPUT_VARIABLE _geos_dynamic ERROR_VARIABLE _geos_readelf_error)
  if(NOT _geos_readelf_status EQUAL 0 OR NOT _geos_dynamic MATCHES "(RUNPATH|RPATH)[^\n]*\\[\\$ORIGIN\\]")
    message(FATAL_ERROR "Bundled GEOS C runtime requires an exact $ORIGIN runtime path: ${_geos_location}. Build it with tools/build_geos_sdk.py. ${_geos_readelf_error}")
  endif()
endforeach()
