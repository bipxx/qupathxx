find_path(OpenSlide_INCLUDE_DIR NAMES openslide.h HINTS "${OpenSlide_ROOT}/include" PATH_SUFFIXES openslide)
find_library(OpenSlide_LIBRARY NAMES openslide libopenslide HINTS "${OpenSlide_ROOT}/lib")
if(WIN32)
  find_file(OpenSlide_RUNTIME NAMES libopenslide-1.dll libopenslide-0.dll HINTS "${OpenSlide_ROOT}/bin")
  set(_OpenSlide_RUNTIME_REQUIRED OpenSlide_RUNTIME)
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(OpenSlide REQUIRED_VARS OpenSlide_INCLUDE_DIR OpenSlide_LIBRARY ${_OpenSlide_RUNTIME_REQUIRED})
if(OpenSlide_FOUND AND NOT TARGET OpenSlide::OpenSlide)
  add_library(OpenSlide::OpenSlide UNKNOWN IMPORTED)
  set_target_properties(OpenSlide::OpenSlide PROPERTIES IMPORTED_LOCATION "${OpenSlide_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${OpenSlide_INCLUDE_DIR}")
endif()
