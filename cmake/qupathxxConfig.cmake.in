@PACKAGE_INIT@
if(NOT WIN32 OR NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT MSVC_VERSION EQUAL @MSVC_VERSION@)
  set(qupathxx_FOUND FALSE)
  set(qupathxx_NOT_FOUND_MESSAGE "This SDK requires Windows x64 MSVC @MSVC_VERSION@; recorded compiler @CMAKE_CXX_COMPILER_VERSION@, Release /MD, iterator level0")
  return()
endif()
set(_qpx_sdk_prefix "${PACKAGE_PREFIX_DIR}")
set(qupathxx_VERSION "@PROJECT_VERSION@")
set(qupathxx_SOURCE_SHA256 "@QPX_SOURCE_SHA256@")
set(qupathxx_GIT_REVISION "@QPX_GIT_REVISION@")
set(qupathxx_COMPILER "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@")
set(qupathxx_core_FOUND TRUE)
set(qupathxx_density_workflow_FOUND @QPX_SDK_DENSITY@)
set(qupathxx_nucls_import_FOUND @QPX_SDK_NUCLS@)
foreach(feature PROJECT INTERCHANGE GEOS OPENSLIDE TIFF H5AD OME_ZARR STATISTICS CLASSIFIER_TRAINING LINEAR_ALGEBRA)
  # Values are assigned below from this configured build, never rediscovered.
  set(qupathxx_FEATURE_${feature} FALSE)
endforeach()
set(qupathxx_FEATURE_PROJECT @QUPATHXX_BUILD_PROJECT@)
set(qupathxx_FEATURE_INTERCHANGE @QUPATHXX_BUILD_INTERCHANGE@)
set(qupathxx_FEATURE_GEOS @QUPATHXX_BUILD_GEOS@)
set(qupathxx_FEATURE_OPENSLIDE @QUPATHXX_BUILD_OPENSLIDE@)
set(qupathxx_FEATURE_TIFF @QUPATHXX_BUILD_TIFF@)
set(qupathxx_FEATURE_H5AD @QUPATHXX_BUILD_H5AD@)
set(qupathxx_FEATURE_OME_ZARR @QUPATHXX_BUILD_OME_ZARR@)
set(qupathxx_FEATURE_STATISTICS @QUPATHXX_BUILD_STATISTICS@)
set(qupathxx_FEATURE_CLASSIFIER_TRAINING @QUPATHXX_BUILD_CLASSIFIER_TRAINING@)
set(qupathxx_FEATURE_LINEAR_ALGEBRA @QPX_SDK_LINEAR@)
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(qupathxx_RUNTIME_FILES "")
if(NOT TARGET qupathxx::core)
  include("${CMAKE_CURRENT_LIST_DIR}/qupathxxDependencies.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/qupathxxTargets.cmake")
else()
  # A repeated find in another directory must not silently select another SDK.
  get_target_property(_qpx_previous qupathxx::core INTERFACE_INCLUDE_DIRECTORIES)
  if(NOT _qpx_previous STREQUAL "${_qpx_sdk_prefix}/include")
    message(FATAL_ERROR "A different qupathxx SDK is already loaded")
  endif()
  get_target_property(qupathxx_RUNTIME_FILES qupathxx::core QUPATHXX_RUNTIME_FILES)
endif()
foreach(file IN LISTS qupathxx_RUNTIME_FILES)
  if(NOT EXISTS "${file}")
    message(FATAL_ERROR "Missing native SDK runtime: ${file}")
  endif()
endforeach()
# Freeze the list on a target so repeat finds/function call sites cannot replace it.
set_property(TARGET qupathxx::core PROPERTY QUPATHXX_RUNTIME_FILES "${qupathxx_RUNTIME_FILES}")
function(qupathxx_stage_runtime target)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "qupathxx_stage_runtime needs an existing target")
  endif()
  get_target_property(files qupathxx::core QUPATHXX_RUNTIME_FILES)
  foreach(file IN LISTS files)
    add_custom_command(TARGET "${target}" POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${file}" "$<TARGET_FILE_DIR:${target}>" VERBATIM)
  endforeach()
endfunction()
check_required_components(qupathxx)
