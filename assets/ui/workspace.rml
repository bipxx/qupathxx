<rml>
<head><title>qupathxx workspace</title></head>
<body id="workspace" schema="1">
  <div id="activity" class="activity">
    <button id="project"><qpx-icon name="project" /></button>
    <button id="image"><qpx-icon name="image" /></button>
    <button id="annotations"><qpx-icon name="annotations" /></button>
    <button id="workflow"><qpx-icon name="workflow" /></button>
  </div>
  <div id="toolbar" class="toolbar">
    <button id="select"><qpx-icon name="select" /></button>
    <button id="rectangle"><qpx-icon name="rectangle" /></button>
    <button id="ellipse"><qpx-icon name="ellipse" /></button>
    <button id="polygon"><qpx-icon name="polygon" /></button>
    <button id="polyline"><qpx-icon name="polyline" /></button>
    <button id="points"><qpx-icon name="points" /></button>
    <button id="vertices"><qpx-icon name="vertices" /></button>
    <button id="hole"><qpx-icon name="hole" /></button>
    <button id="fit"><qpx-icon name="fit" /></button>
    <button id="undo"><qpx-icon name="undo" /></button>
    <button id="redo"><qpx-icon name="redo" /></button>
    <button id="spatial"><qpx-icon name="spatial" /></button>
    <button id="channels"><qpx-icon name="channels" /></button>
    <button id="reset"><qpx-icon name="reset" /></button>
  </div>
  <div id="tooltip" />
</body>
</rml>
