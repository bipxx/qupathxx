#pragma once
#if !defined(_MSC_VER) || _MSC_VER != @QUPATHXX_READER_PLUGIN_MSVC_VERSION@ || !defined(_WIN64) || !defined(_M_X64)
#error "Image plugin requires the ReaderPluginKit Windows x64 MSVC profile"
#endif
#if !defined(_DLL) || defined(_DEBUG)
#error "Image plugin requires Release dynamic CRT (/MD)"
#endif
#include <yvals_core.h>
#if _ITERATOR_DEBUG_LEVEL != 0
#error "Image plugin requires iterator debug level zero"
#endif
static_assert(sizeof(void*) == 8, "Image plugin architecture differs");
