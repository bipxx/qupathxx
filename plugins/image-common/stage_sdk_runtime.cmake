# Stage only the matching SDK runtime files reachable from the linked module.
get_filename_component(module_dir "${MODULE_FILE}" DIRECTORY)
set(known_names "")
foreach(file IN LISTS SDK_RUNTIME_FILES)
  if(NOT EXISTS "${file}")
    message(FATAL_ERROR "Missing matching native SDK runtime: ${file}")
  endif()
  get_filename_component(name "${file}" NAME)
  string(TOLOWER "${name}" lower_name)
  list(APPEND known_names "${lower_name}")
  set("native_file_${lower_name}" "${file}")
endforeach()
set(pending "${MODULE_FILE}")
set(visited "")
set(selected "")
while(pending)
  list(POP_FRONT pending file)
  if(file IN_LIST visited)
    continue()
  endif()
  list(APPEND visited "${file}")
  execute_process(COMMAND "${DUMPBIN}" /NOLOGO /DEPENDENTS "${file}"
    RESULT_VARIABLE exit_code OUTPUT_VARIABLE imports ERROR_VARIABLE failure)
  if(NOT exit_code EQUAL 0)
    message(FATAL_ERROR "Cannot inspect native import graph: ${file}: ${failure}")
  endif()
  string(TOLOWER "${imports}" imports)
  string(REGEX MATCHALL "[a-z0-9_.-]+\\.dll" names "${imports}")
  foreach(name IN LISTS names)
    if(name IN_LIST known_names AND NOT name IN_LIST selected)
      list(APPEND selected "${name}")
      list(APPEND pending "${native_file_${name}}")
    endif()
  endforeach()
endwhile()
list(SORT selected)
set(dependencies "")
foreach(name IN LISTS selected)
  set(source "${native_file_${name}}")
  set(target "${module_dir}/${name}")
  file(SHA256 "${source}" digest)
  if(EXISTS "${target}")
    file(SHA256 "${target}" target_digest)
    if(NOT target_digest STREQUAL digest)
      message(FATAL_ERROR "Refuse to replace another native runtime identity: ${target}")
    endif()
  else()
    file(COPY_FILE "${source}" "${target}" ONLY_IF_DIFFERENT)
  endif()
  if(NOT dependencies STREQUAL "")
    string(APPEND dependencies ",\n")
  endif()
  string(APPEND dependencies "      {\"path\": \"${name}\", \"sha256\": \"${digest}\"}")
endforeach()
