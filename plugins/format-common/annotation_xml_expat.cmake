include_guard(GLOBAL)
# One exact private static parser may serve independently linked annotation DLLs
# in a combined cached build. Every caller verifies the admitted source bytes.
function(qpx_annotation_xml_expat consumer lock_file source_dir)
  if(NOT IS_DIRECTORY "${source_dir}")
    message(FATAL_ERROR "Provide the exact admitted Expat2.10.0 source selection; no downloads")
  endif()
  file(READ "${lock_file}" reference_lock)
  string(JSON parser_lock GET "${reference_lock}" expat)
  string(SHA256 parser_identity "${parser_lock}")
  string(JSON member_count LENGTH "${reference_lock}" expat members)
  math(EXPR last_member "${member_count}-1")
  foreach(index RANGE ${last_member})
    string(JSON member MEMBER "${reference_lock}" expat members ${index})
    string(JSON expected GET "${reference_lock}" expat members "${member}" sha256)
    if(NOT EXISTS "${source_dir}/${member}")
      message(FATAL_ERROR "Missing admitted Expat input: ${member}")
    endif()
    file(SHA256 "${source_dir}/${member}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Expat input identity differs: ${member}")
    endif()
  endforeach()
  if(TARGET expat)
    get_property(existing_identity GLOBAL PROPERTY QPX_ANNOTATION_EXPAT_IDENTITY)
    if(NOT existing_identity STREQUAL parser_identity)
      message(FATAL_ERROR "An unrelated or differently configured Expat target is already present")
    endif()
  else()
    foreach(option BUILD_TOOLS BUILD_EXAMPLES BUILD_TESTS SHARED_LIBS BUILD_DOCS BUILD_FUZZERS BUILD_PKGCONFIG OSSFUZZ_BUILD ENABLE_INSTALL MSVC_STATIC_CRT)
      set(EXPAT_${option} OFF CACHE BOOL "Private annotation XML Expat profile" FORCE)
    endforeach()
    set(EXPAT_NS ON CACHE BOOL "Namespace-aware XML" FORCE)
    set(EXPAT_DTD ON CACHE BOOL "Upstream parser; application rejects all DTDs" FORCE)
    set(EXPAT_GE ON CACHE BOOL "Built-in XML entities; application rejects declarations" FORCE)
    set(EXPAT_CHAR_TYPE char CACHE STRING "UTF-8 callback values" FORCE)
    set(EXPAT_CONTEXT_BYTES 1024 CACHE STRING "Bounded parser context" FORCE)
    add_subdirectory("${source_dir}" "${CMAKE_CURRENT_BINARY_DIR}/expat" EXCLUDE_FROM_ALL)
    set_property(TARGET expat PROPERTY MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
    target_compile_options(expat PRIVATE /utf-8)
    set_property(GLOBAL PROPERTY QPX_ANNOTATION_EXPAT_IDENTITY "${parser_identity}")
  endif()
  target_link_libraries(${consumer} PRIVATE expat::expat)
endfunction()
