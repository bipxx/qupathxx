set(QUPATHXX_NGFF05_SNAPPY_ARCHIVE "" CACHE FILEPATH "Admitted Snappy 1.2.2 source archive")
file(READ "${CMAKE_CURRENT_LIST_DIR}/../parquet_matrix/decoder-sources.json" qpx_snappy_lock)
string(JSON expected GET "${qpx_snappy_lock}" "snappy-1.2.2.tar.gz" sha256)
file(SHA256 "${QUPATHXX_NGFF05_SNAPPY_ARCHIVE}" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Snappy archive differs from its admitted source lock")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${QUPATHXX_NGFF05_SNAPPY_ARCHIVE}")
set(qpx_snappy_inputs "${CMAKE_CURRENT_BINARY_DIR}/snappy-inputs")
file(ARCHIVE_EXTRACT INPUT "${QUPATHXX_NGFF05_SNAPPY_ARCHIVE}" DESTINATION "${qpx_snappy_inputs}")
set(qpx_snappy_dir "${qpx_snappy_inputs}/snappy-1.2.2")
function(qpx_add_private_snappy)
  # Snappy's minimum predates CMP0077. Honor the parent-scoped options
  # because the source archive deliberately has no test submodules.
  set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
  set(BUILD_SHARED_LIBS OFF)
  set(SNAPPY_BUILD_TESTS OFF)
  set(SNAPPY_BUILD_BENCHMARKS OFF)
  set(SNAPPY_INSTALL OFF)
  add_subdirectory("${qpx_snappy_dir}" "${CMAKE_CURRENT_BINARY_DIR}/snappy-build" EXCLUDE_FROM_ALL)
endfunction()
qpx_add_private_snappy()
install(FILES "${qpx_snappy_dir}/COPYING" DESTINATION licenses/snappy)
