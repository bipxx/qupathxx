set(QUPATHXX_NPZ_ZLIB_ARCHIVE "" CACHE FILEPATH "Admitted zlib 1.3.2 source archive")
if(NOT EXISTS "${QUPATHXX_NPZ_ZLIB_ARCHIVE}")
  message(FATAL_ERROR "Provide the pinned offline zlib 1.3.2 source archive")
endif()
file(SHA256 "${QUPATHXX_NPZ_ZLIB_ARCHIVE}" zlib_digest)
if(NOT zlib_digest STREQUAL "bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16"
   OR NOT CMAKE_C_COMPILER_VERSION STREQUAL QUPATHXX_FORMAT_PLUGIN_CXX_COMPILER_VERSION)
  message(FATAL_ERROR "Unexpected zlib source or C compiler")
endif()
set(zlib "${CMAKE_CURRENT_BINARY_DIR}/zlib-source/zlib-1.3.2")
if(NOT EXISTS "${zlib}/CMakeLists.txt")
  file(ARCHIVE_EXTRACT INPUT "${QUPATHXX_NPZ_ZLIB_ARCHIVE}" DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/zlib-source")
endif()
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
set(ZLIB_BUILD_SHARED OFF CACHE BOOL "" FORCE)
set(ZLIB_BUILD_STATIC ON CACHE BOOL "" FORCE)
set(ZLIB_BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(ZLIB_INSTALL OFF CACHE BOOL "" FORCE)
set(ZLIB_PREFIX ON CACHE BOOL "" FORCE)
set(Z_PREFIX ON)
add_subdirectory("${zlib}" "${CMAKE_CURRENT_BINARY_DIR}/zlib" EXCLUDE_FROM_ALL)
set(zlib_headers "${CMAKE_CURRENT_BINARY_DIR}/zlib/include")
configure_file("${zlib}/zlib.h" "${zlib_headers}/zlib.h" COPYONLY)
configure_file("${CMAKE_CURRENT_BINARY_DIR}/zlib/zconf.h" "${zlib_headers}/zconf.h" COPYONLY)
file(READ "${zlib_headers}/zconf.h" zlib_config)
if(NOT zlib_config MATCHES "#define Z_PREFIX 1")
  message(FATAL_ERROR "NPZ requires private prefixed zlib symbols")
endif()
target_include_directories(${qpx_provider_target} PRIVATE "${zlib_headers}")
target_link_libraries(${qpx_provider_target} PRIVATE zlibstatic)
install(FILES "${zlib}/LICENSE" DESTINATION licenses/zlib)
